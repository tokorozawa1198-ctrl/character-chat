# 떡존이 local environment template
# Copy to .env.local for local development. Never commit real secrets.

# AI chat provider
DEEPSEEK_API_KEY=

# OpenAI features: TTS and push-message generation
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=onyx
PUSH_NAG_MODEL=gpt-4o-mini

# Auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Supabase server-side admin access
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Scheduled routes / Vercel Cron protection
CRON_SECRET=
